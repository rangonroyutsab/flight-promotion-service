DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=change-me-local
TZ=Asia/Dhaka

POSTGRES_DB=flight_promotions
POSTGRES_USER=flight_app
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=change-me
ELASTICSEARCH_INDEX=kibana_sample_data_flights

KIBANA_URL=http://kibana:5601

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_SECURE=false
MINIO_BUCKET=flight-promotions
MINIO_READ_CONCURRENCY=5

AI_PROVIDER=mock
AI_MODEL=mock-model
AI_API_KEY=change-me
AI_PROMPT_VERSION=flight-promotion-v1
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.1-flash-lite:generateContent
DEFAULT_TIMEOUT_SECONDS=10

PROMOTION_RESULT_LIMIT=5
PROMOTION_MIN_PRICE_USD=500
PROMOTION_DESTINATION_COUNTRY=US

AI_MAX_RETRIES=3
ELASTICSEARCH_MAX_RETRIES=3
MINIO_MAX_RETRIES=3

PROMOTION_TITLE_MAX_LENGTH=100
PROMOTION_CONTENT_MIN_WORDS=50
PROMOTION_CONTENT_MAX_WORDS=120
